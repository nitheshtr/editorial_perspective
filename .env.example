# Editorial Perspective Map — pipeline secrets
# Copy to .env and fill in. NEVER commit .env.

# Required: default provider (config/pipeline.json models.*.provider = "openrouter")
OPENROUTER_API_KEY=

# Required: search provider for the research stage (config/pipeline.json search.provider = "tavily")
TAVILY_API_KEY=

# Optional: only needed if a stage is pinned to these providers in config/pipeline.json
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
